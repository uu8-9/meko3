// ─── UTILS ───────────────────────────────────────────────
// Statusas skaičiuojamas automatiškai iš kiekio, MIN, MAX
function calcStatus(kiekis, min, max){
  if(kiekis < min) return 'Trūkumas';
  if(kiekis > max) return 'Perteklius';
  return 'Norma';
}
function scls(s){
  if(s==='Norma') return 'td-ok';
  if(s==='Perteklius') return 'td-wa';
  return 'td-cr'; // Trūkumas
}
function slbl(s){
  if(s==='Norma') return '✓ Norma';
  if(s==='Perteklius') return '↑ Perteklius';
  return '↓ Trūkumas';
}
function rowSel(tr){tr.parentNode.querySelectorAll('tr').forEach(r=>r.classList.remove('selected'));tr.classList.add('selected');}
function fmtDate(d){
  if(!d) return d;
  const p=d.split('.');
  if(p.length===3) return `${p[2]}-${p[1]}-${p[0]}`;
  return d;
}

// ─── P1 ──────────────────────────────────────────────────
function p1filter(){
  const gr=document.getElementById('p1grupe').value;
  const ko=document.getElementById('p1kodas').value;
  const pr=document.getElementById('p1preke').value;
  const sa=document.getElementById('p1sandelis').value;
  const nu=document.getElementById('p1nukr').value;
  const ju=document.getElementById('p1jud').value;
  const rows=STOCK.filter(r=>(!gr||r.grupe===gr)&&(!ko||r.kodas===ko)&&(!pr||r.preke===pr)&&(!sa||r.sandelis===sa));
  const tb=document.getElementById('p1tbody');
  const nd=document.getElementById('p1nodata');
  if(!rows.length){tb.innerHTML='';nd.style.display='flex';}
  else{nd.style.display='none';}

  // Group by unique product, sum kiekis across warehouses
  const productMap={};
  rows.forEach(r=>{
    if(!productMap[r.kodas]){
      productMap[r.kodas]={kodas:r.kodas,grupe:r.grupe,preke:r.preke,min:r.min,max:r.max,totalKiekis:0,sandelia:[]};
    }
    productMap[r.kodas].totalKiekis+=r.kiekis;
    productMap[r.kodas].sandelia.push({sandelis:r.sandelis,kiekis:r.kiekis});
  });

  // Sort by bendras kiekis descending
  const products=Object.values(productMap)
    .filter(p=>(!nu||calcStatus(p.totalKiekis,p.min,p.max)===nu))
    .sort((a,b)=>b.totalKiekis-a.totalKiekis);

  // Default: first product expanded
  const expandedSet=new Set([products[0]?.kodas]);

  function renderMatrix(){
    let html='';
    products.forEach(p=>{
      const isExp=expandedSet.has(p.kodas);
      const icon=isExp?'▼':'▶';
      html+=`<tr style="height:36px;border-bottom:1px solid #F0EFED;background:#fff;cursor:pointer;" onclick="toggleRow('${p.kodas}')">
        <td style="padding:0 6px 0 10px;white-space:nowrap;font-size:11px;color:#0D3D35;width:18px;flex-shrink:0;">${icon}</td>
        <td style="padding:0 6px;white-space:nowrap;font-size:10px;color:#333;">${p.preke}</td>
        <td style="padding:0 6px;white-space:nowrap;font-size:10px;font-variant-numeric:tabular-nums;text-align:right;font-weight:600;color:#0D3D35;">${p.totalKiekis}</td>
        <td style="padding:0 6px;white-space:nowrap;font-size:10px;font-variant-numeric:tabular-nums;text-align:right;color:#555;">${p.min}</td>
      </tr>`;
      if(isExp){
        p.sandelia.forEach(s=>{
          html+=`<tr style="height:36px;border-bottom:1px solid #F0EFED;background:#FAFAFA;">
            <td style="padding:0;width:18px;"></td>
            <td style="padding-left:20px;font-size:10px;color:#555;white-space:nowrap;">${s.sandelis}</td>
            <td style="padding:0 6px;font-size:10px;font-variant-numeric:tabular-nums;text-align:right;color:#333;white-space:nowrap;font-weight:600;">${s.kiekis}</td>
            <td style="padding:0;"></td>
          </tr>`;
        });
      }
    });
    tb.innerHTML=html;
  }

  window.toggleRow=function(kodas){
    if(expandedSet.has(kodas)) expandedSet.delete(kodas);
    else expandedSet.add(kodas);
    renderMatrix();
  };

  renderMatrix();
  // KPI
  const tr=rows.filter(r=>r.status==='Viršyta').length;
  const de=rows.filter(r=>r.status==='Dėmesio').length;
  const no=rows.filter(r=>r.status==='Norma').length;
  document.getElementById('k1a').textContent=tr;
  document.getElementById('k2a').textContent=de;
  document.getElementById('k4a').textContent=no;
  // Bars — pridedame gr ir ko filtravimą
  const sanList=sa?[sa]:SANDELIA;
  document.getElementById('p1bars').innerHTML=sanList.map(s=>{
    const sr=STOCK.filter(r=>r.sandelis===s&&(!gr||r.grupe===gr)&&(!ko||r.kodas===ko)&&(!pr||r.preke===pr)&&(!nu||r.status===nu));
    const tot=sr.length||0;
    const vP=tot?Math.round(sr.filter(r=>r.status==='Viršyta').length/tot*100):0;
    const dP=tot?Math.round(sr.filter(r=>r.status==='Dėmesio').length/tot*100):0;
    const lbl=s.replace(' sandėlis','');
    return `<div style="display:flex;align-items:center;gap:6px;margin-bottom:4px;">
      <div style="width:72px;text-align:right;font-size:10px;color:#555;flex-shrink:0;">${lbl}</div>
      <div style="flex:1;border-radius:3px;height:16px;overflow:hidden;display:flex;background:#E0E0E0;">
        ${vP?`<div style="width:${vP}%;background:#DC2626;display:flex;align-items:center;justify-content:center;"><span style="font-size:9px;color:#fff;padding:0 3px;">${vP>12?'Viršyta':''}</span></div>`:''}
        ${dP?`<div style="width:${dP}%;background:#D97706;display:flex;align-items:center;justify-content:center;"><span style="font-size:9px;color:#fff;padding:0 3px;">${dP>12?'Dėmesio':''}</span></div>`:''}
        <div style="flex:1;background:#E0E0E0;display:flex;align-items:center;justify-content:center;"><span style="font-size:9px;color:#999;">Norma</span></div>
      </div>
      <div style="width:16px;text-align:right;font-size:10px;color:#555;">${tot}</div>
    </div>`;
  }).join('');
  // Judėjimai — filtruojame pagal gr, ko, sandelis, tipas
  const mv=MOVES.filter(r=>(!gr||r.grupe===gr)&&(!ko||r.kodas===ko)&&(!pr||r.preke===pr)&&(!ju||r.tipas===ju)&&(!sa||r.sandelis.startsWith(sa.split(' ')[0])));
  document.getElementById('p1mov').innerHTML=mv.map(r=>`<tr onclick="rowSel(this)">
    <td style="white-space:nowrap;font-size:10px;padding:6px 6px;">${r.data}</td>
    <td style="white-space:nowrap;font-size:10px;padding:6px 6px;">${r.preke}</td>
    <td style="white-space:nowrap;font-size:10px;padding:6px 6px;">${r.is}</td>
    <td style="white-space:nowrap;font-size:10px;padding:6px 6px;">${r.i}</td>
    <td style="white-space:nowrap;font-size:10px;padding:6px 6px;">${r.tipas}</td>
    <td style="white-space:nowrap;font-size:10px;padding:6px 6px;font-variant-numeric:tabular-nums;">${r.kiekis}</td></tr>`).join('');
  // Rekomendacijos — filtruojame pagal gr, ko, preke
  const rc=RECS.filter(r=>(!gr||r.grupe===gr)&&(!ko||r.kodas===ko)&&(!pr||r.preke===pr));
  document.getElementById('p1rec').innerHTML=rc.map(r=>`<tr onclick="rowSel(this)">
    <td style="white-space:nowrap;font-size:10px;padding:6px 6px;">${r.preke}</td>
    <td style="white-space:nowrap;font-size:10px;padding:6px 6px;">${r.is}</td>
    <td style="white-space:nowrap;font-size:10px;padding:6px 6px;">${r.i}</td>
    <td style="white-space:nowrap;font-size:10px;padding:6px 6px;font-variant-numeric:tabular-nums;">${r.kiekis}</td></tr>`).join('');
  // KPI k3 — rekomendacijų skaičius
  document.getElementById('k3a').textContent=rc.length;
  p1updateClear();
}

// ─── P2 ──────────────────────────────────────────────────
function p2filter(){
  const gr=document.getElementById('p2grupe').value;
  const ko=document.getElementById('p2kodas').value;
  const pr=document.getElementById('p2preke').value;
  const is=document.getElementById('p2is').value;
  const ii=document.getElementById('p2i').value;
  const rz=document.getElementById('p2rez').value;
  const nu=document.getElementById('p2nukr').value;
  const rows=P2DATA.filter(r=>(!gr||r.grupe===gr)&&(!ko||r.kodas===ko)&&(!pr||r.preke===pr)&&(!is||r.is===is)&&(!ii||r.i===ii)&&(!rz||r.rez===rz)&&(!nu||r.status===nu));
  document.getElementById('p2tbody').innerHTML=rows.map(r=>{
    const st=calcStatus(r.lik,r.min,r.max);
    return `<tr onclick="rowSel(this)">
    <td style="white-space:nowrap;font-size:10px;color:#888;">${r.kodas}</td>
    <td style="white-space:nowrap;font-size:10px;color:#888;">${r.grupe}</td>
    <td style="white-space:nowrap;font-size:10px;">${r.preke}</td>
    <td style="white-space:nowrap;font-size:10px;">${r.is}</td>
    <td style="white-space:nowrap;font-size:10px;">${r.i}</td>
    <td style="white-space:nowrap;font-size:10px;font-variant-numeric:tabular-nums;">${r.kiekis}</td>
    <td style="white-space:nowrap;font-size:10px;font-variant-numeric:tabular-nums;">${r.lik}</td>
    <td style="white-space:nowrap;font-size:10px;font-variant-numeric:tabular-nums;">${r.min}</td>
    <td style="white-space:nowrap;font-size:10px;font-variant-numeric:tabular-nums;">${r.max}</td>
    <td class="${scls(st)}">${slbl(st)}</td></tr>`;}).join('');
  document.getElementById('p2k1').textContent=rows.length;
  document.getElementById('p2k2').textContent=rows.filter(r=>r.status==='Viršyta').length;
  document.getElementById('p2k3').textContent=[...new Set(rows.map(r=>r.is))].length;
  // Grouped bar — faktinis vs MIN per sandėlis
  const S=['Sandėlis-1','Sandėlis-2','Sandėlis-3','Sandėlis-4'];
  const maxVal=400;
  document.getElementById('p2chart').innerHTML=S.map(s=>{
    const sr=rows.filter(r=>r.is===s);
    const faktinis=sr.reduce((a,r)=>a+r.lik,0);
    const minSum=sr.reduce((a,r)=>a+r.min,0);
    const fPct=Math.min(Math.round(faktinis/maxVal*100),100);
    const mPct=Math.min(Math.round(minSum/maxVal*100),100);
    const belowMin=faktinis<minSum;
    return `<div style="display:flex;flex-direction:column;gap:2px;">
      <div style="font-size:10px;color:#555;font-weight:600;">${s}</div>
      <div style="display:flex;align-items:center;gap:6px;">
        <div style="width:48px;font-size:9px;color:#888;text-align:right;flex-shrink:0;">Faktinis</div>
        <div style="flex:1;background:#F0EFED;border-radius:3px;height:13px;overflow:hidden;">
          <div style="width:${fPct}%;height:100%;background:${belowMin?'#DC2626':'#1DB88A'};border-radius:3px;"></div>
        </div>
        <div style="width:28px;font-size:10px;color:#333;text-align:right;">${faktinis}</div>
      </div>
      <div style="display:flex;align-items:center;gap:6px;">
        <div style="width:48px;font-size:9px;color:#888;text-align:right;flex-shrink:0;">MIN</div>
        <div style="flex:1;background:#F0EFED;border-radius:3px;height:13px;overflow:hidden;">
          <div style="width:${mPct}%;height:100%;background:#94A3B8;border-radius:3px;"></div>
        </div>
        <div style="width:28px;font-size:10px;color:#333;text-align:right;">${minSum}</div>
      </div>
    </div>`;
  }).join('');
  p2updateClear();
}

