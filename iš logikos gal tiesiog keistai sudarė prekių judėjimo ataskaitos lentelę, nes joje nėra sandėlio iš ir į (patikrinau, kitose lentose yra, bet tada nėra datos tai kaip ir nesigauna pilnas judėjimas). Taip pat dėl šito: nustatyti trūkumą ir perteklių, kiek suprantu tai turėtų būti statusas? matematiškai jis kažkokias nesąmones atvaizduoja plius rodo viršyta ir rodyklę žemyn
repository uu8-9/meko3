.panel { background:#fff; border:1px solid #E0E0E0; border-radius:8px; display:flex; flex-direction:column; overflow:hidden; min-width:0; }
.pt { padding:8px 8px 7px 20px; font-size:12px; font-weight:600; color:#0D3D35; border-bottom:1px solid #E0E0E0; flex-shrink:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }

.tw { overflow-x:auto; overflow-y:scroll; flex:1; min-height:0; }
.tw::-webkit-scrollbar { width:6px; height:6px; }
.tw::-webkit-scrollbar-track { background:#F5F5F5; border-radius:3px; }
.tw::-webkit-scrollbar-thumb { background:#C8C8C8; border-radius:3px; }
.tw::-webkit-scrollbar-thumb:hover { background:#A0A0A0; }
table { width:max-content; min-width:100%; border-collapse:collapse; font-size:12px; table-layout:auto; }
thead th { position:sticky; top:0; background:#F8F7F6; padding:6px 8px; text-align:left; font-weight:600; color:#6B7280; border-bottom:2px solid #E0E0E0; white-space:nowrap; font-size:11px; z-index:1; }
tbody tr { border-bottom:1px solid #F0EFED; cursor:pointer; background:#fff; transition:background .1s; }
tbody tr:hover { background:#F8F8F8; }
tbody tr.selected { background:#EDFAF5; }
tbody td { padding:5px 8px; color:#333; font-size:11px; white-space:nowrap; }

/* Statusų langelių spalvos */
