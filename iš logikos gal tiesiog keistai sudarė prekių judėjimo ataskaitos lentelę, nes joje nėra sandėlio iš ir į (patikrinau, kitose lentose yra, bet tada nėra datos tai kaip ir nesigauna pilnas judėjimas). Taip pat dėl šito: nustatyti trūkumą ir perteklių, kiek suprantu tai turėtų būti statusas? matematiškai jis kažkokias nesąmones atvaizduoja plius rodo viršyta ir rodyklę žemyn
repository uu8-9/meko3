  document.getElementById('p3k1').textContent=pert;
  document.getElementById('p3k2').textContent=truk;
  document.getElementById('p3k3').textContent=Math.max(0,truk);

  // Statusų pasiskirstymo grafikas
  const tot=rows.length||1;
