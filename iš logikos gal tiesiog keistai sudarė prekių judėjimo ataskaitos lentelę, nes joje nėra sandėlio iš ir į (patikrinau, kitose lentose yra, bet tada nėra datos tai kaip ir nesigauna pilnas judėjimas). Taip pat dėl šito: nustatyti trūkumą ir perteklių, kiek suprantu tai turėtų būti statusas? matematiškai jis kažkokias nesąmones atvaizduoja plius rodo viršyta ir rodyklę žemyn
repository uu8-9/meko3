.sidebar { width:180px; flex-shrink:0; background:#0D3D35; display:flex; flex-direction:column; padding:0; }
.sidebar-logo { padding:14px 16px 10px; border-bottom:1px solid rgba(255,255,255,0.08); flex-shrink:0; }
.sidebar-nav { display:flex; flex-direction:column; gap:2px; padding:10px 8px; flex:1; }
.side-tab { padding:9px 12px; border-radius:6px; font-size:12px; color:rgba(255,255,255,0.6); cursor:pointer; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; transition:background .12s,color .12s; user-select:none; }
