.td-wa { background:#FEF3C7; color:#92400E; font-weight:600; font-size:11px; white-space:nowrap; padding:5px 8px; }
.td-cr { background:#FEE2E2; color:#991B1B; font-weight:600; font-size:11px; white-space:nowrap; padding:5px 8px; }
.ok { color:#1DB88A; font-weight:600; }
.wa { color:#D97706; font-weight:600; }
