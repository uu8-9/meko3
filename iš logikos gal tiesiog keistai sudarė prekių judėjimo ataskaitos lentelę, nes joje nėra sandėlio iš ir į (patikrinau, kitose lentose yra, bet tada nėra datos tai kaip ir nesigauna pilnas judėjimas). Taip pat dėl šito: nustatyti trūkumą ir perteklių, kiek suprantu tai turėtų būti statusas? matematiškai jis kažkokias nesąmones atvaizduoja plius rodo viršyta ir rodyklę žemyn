.side-tab.active { background:rgba(29,184,138,0.18); color:#1DB88A; font-weight:600; border-left:3px solid #1DB88A; padding-left:9px; }
.sidebar-bottom { padding:12px 16px; border-top:1px solid rgba(255,255,255,0.08); font-size:10px; color:rgba(255,255,255,0.35); }

/* ── Pagrindinis turinys ── */
.main { flex:1; display:flex; flex-direction:column; overflow:hidden; min-width:0; }
.page { display:none; flex-direction:column; flex:1; overflow:hidden; }
.page.active { display:flex; }

.page-header { display:none; }
.page-title { display:none; }
.timestamp { display:none; }

.page-title-bar {
  display:flex; align-items:baseline; justify-content:space-between;
  padding:8px 20px 6px 20px;
  background:#fff; border-bottom:1px solid #E0E0E0; flex-shrink:0;
}
.page-title-bar .ptitle { font-size:16px; font-weight:700; color:#0D3D35; }
.page-title-bar .pts { font-size:11px; color:#bbb; }

.filter-bar { display:flex; align-items:center; background:#fff; border-bottom:1px solid #E0E0E0; flex-shrink:0; padding:0; }
.filter-title-block { display:none; }
.filter-inputs { display:flex; align-items:center; gap:8px; padding:6px 20px; flex:1; flex-wrap:nowrap; }
.fg { display:flex; flex-direction:column; gap:2px; flex-shrink:0; }
.fl { font-size:10px; color:#888; font-weight:500; }
